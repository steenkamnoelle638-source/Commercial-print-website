/* Refined corporate finish: confident navy, clean whites and restrained red accents. */
:root{--forest:#00589A;--forest2:#007BC0;--lime:#B6504A;--cream:#F5FAFB;--ink:#123047;--muted:#5D6B7B;--line:#DFE6EF;--white:#fff;--radius:22px;--shadow-soft:0 18px 50px rgba(7,59,117,.09)}
body{background:#F5FAFB;color:#123047}
::selection{background:#B6504A;color:#fff}
.site-header{background:rgba(255,255,255,.94);border-bottom-color:rgba(7,59,117,.12);box-shadow:0 4px 24px rgba(7,59,117,.035)}
.brand-mark{border-radius:12px;box-shadow:0 6px 15px rgba(229,57,75,.18)}
.site-header nav{gap:clamp(14px,2vw,28px)}
.nav-cta,.button{box-shadow:0 8px 20px rgba(7,59,117,.12)}
.button.light{color:#fff;box-shadow:0 8px 22px rgba(229,57,75,.22)}
.button.outline{border-color:rgba(255,255,255,.48)}
.hero{background:radial-gradient(ellipse at 78% 12%,rgba(38,112,181,.65) 0%,transparent 44%),linear-gradient(120deg,#004A78 0%,#00589A 58%,#006B9E 100%)}
.hero:after{border-color:rgba(255,255,255,.16);box-shadow:0 0 0 70px rgba(255,255,255,.025),0 0 0 140px rgba(229,57,75,.035)}
.hero .eyebrow{color:#E6B9B4}.hero .eyebrow:before{background:#B6504A}
.hero-copy{color:#E0EAF5}.hero-note{color:#D7E5F4}.status-dot{background:#B6504A;box-shadow:0 0 0 5px rgba(229,57,75,.18)}
.art-card{box-shadow:0 30px 80px rgba(0,20,48,.34)}
.art-back{background:linear-gradient(145deg,#fff 0%,#EAF7FA 100%)}
.art-front{background:linear-gradient(145deg,#D2655B 0%,#B6504A 100%);color:#fff}
.art-sticker{background:#007BC0;border-color:rgba(255,255,255,.5);box-shadow:0 15px 35px rgba(0,20,48,.2)}
.trust-strip{box-shadow:0 10px 30px rgba(7,59,117,.025)}
