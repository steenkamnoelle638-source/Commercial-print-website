nt-size:2rem;max-width:320px}.check-list{list-style:none;margin:24px 0 0;padding:0;display:grid;gap:14px}.check-list li{display:flex;gap:12px;align-items:flex-start}.check-list li:before{content:'✓';width:23px;height:23px;flex:0 0 23px;display:grid;place-items:center;border-radius:50%;background:#e4efd6;color:var(--forest);font-weight:800;font-size:.75rem}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.step{border-top:2px solid var(--forest);padding:24px 12px 0 0}.step-num{font-size:.74rem;color:var(--forest2);font-weight:800;letter-spacing:.12em}.step h3{margin-top:17px}.quote-section{background:#e9ede4}.quote-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px;align-items:start}.quote-copy{position:sticky;top:120px}.contact-note{margin-top:30px;padding:18px;background:#fff;border-radius:16px;font-size:.9rem}.quote-form{background:white;padding:34px;border-radius:24px;box-shadow:0 18px 50px #18382b0b}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:17px}.field.full{grid-column:1/-1}.field label{font-size:.82rem;font-weight:700}.field input,.field textarea,.field select{width:100%;padding:13px 14px;border:1px solid #dce2db;border-radius:10px;background:#fcfcfa;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--forest2);box-shadow:0 0 0 3px #24544812}.field textarea{min-height:110px;resize:vertical}.form-small{font-size:.78rem;margin:12px 0 0}.quote-form .button{width:100%;cursor:pointer}.site-footer{background:#112f27;color:white;padding:55px max(22px,calc((100vw - 1160px)/2)) 22px}.footer-main{display:grid;grid-template-columns:1fr 1.2fr auto;gap:35px;align-items:center;padding-bottom:42px}.brand-light .brand-mark{background:var(--lime)}.brand-light small{color:#b4c5bb}.site-footer p{color:#c0cec6;max-width:410px;margin:0}.footer-link{font-weight:700;color:var(--lime);white-space:nowrap}.footer-bottom{border-top:1px solid #ffffff22;padding-top:20px;display:flex;justify-content:space-between;gap:20px;color:#b4c5bb;font-size:.78rem}.whatsapp-float{position:fixed;right:22px;bottom:22px;z-index:40;background:#d6f59b;color:#173c32;border-radius:999px;padding:13px 19px;box-shadow:0 10px 32px #173c3240;font-weight:800;font-size:.88rem}.page-hero{padding:78px 0 70px;background:var(--forest);color:white}.page-hero h1{font-size:clamp(2.5rem,5vw,4.5rem);max-width:900px}.page-hero p{color:#d2ddd6;font-size:1.1rem;max-width:760px}.breadcrumbs{font-size:.82rem;color:#bdcdc3;margin-bottom:24px}.breadcrumbs a{text-decoration:underline;text-underline-offset:3px}.product-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:start}.spec-box{background:white;border:1px solid var(--line);border-radius:22px;padding:28px}.spec-box h2{font-size:1.6rem}.spec-box ul{padding-left:20px;color:var(--muted);display:grid;gap:11px}.search-wrap{display:flex;gap:10px;max-width:650px;margin:25px 0 42px}.search-wrap input{flex:1;min-width:0;border:1px solid #dce2db;border-radius:999px;padding:14px 20px;background:white}.search-wrap button{border:0;cursor:pointer}.search-results{font-size:.9rem;color:var(--muted);margin-top:-25px;margin-bottom:20px}.notice{background:#fff8df;border:1px solid #eddfab;padding:16px 18px;border-radius:12px;font-size:.88rem;color:#6b5b22}.local-badge{font-size:.78rem;font-weight:700;background:#eaf0e7;border-radius:99px;padding:8px 12px;display:inline-block;margin-bottom:18px}
@media(max-width:850px){.site-header nav{display:none;position:absolute;top:85px;left:0;right:0;background:var(--cream);padding:20px 24px 26px;box-shadow:0 18px 25px #173c3210;align-items:stretch;gap:18px;flex-direction:column}.site-header nav.is-open{display:flex}.menu-toggle{display:block}.hero-grid,.split,.quote-grid,.product-layout{grid-template-columns:1fr;gap:38px}.hero{padding:65px 0}.hero-art{min-height:360px;max-width:470px;width:100%;margin:auto}.trust-inner{grid-template-columns:1fr;gap:15px}.products-grid{grid-template-columns:repeat(2,1fr)}.quote-copy{position:static}.footer-main{grid-template-columns:1fr;gap:22px}.section{padding:72px 0}.steps{grid-template-columns:1fr;gap:30px}.feature-panel{min-height:340px}}
