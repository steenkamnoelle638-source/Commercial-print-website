/* Refined corporate finish: confident navy, clean whites and restrained red accents. */
:root{--forest:#073B75;--forest2:#15599B;--lime:#E5394B;--cream:#F5F7FA;--ink:#142338;--muted:#5D6B7B;--line:#DFE6EF;--white:#fff;--radius:22px;--shadow-soft:0 18px 50px rgba(7,59,117,.09)}
body{background:#F5F7FA;color:#142338}
::selection{background:#E5394B;color:#fff}
.site-header{background:rgba(255,255,255,.94);border-bottom-color:rgba(7,59,117,.12);box-shadow:0 4px 24px rgba(7,59,117,.035)}
.brand-mark{border-radius:12px;box-shadow:0 6px 15px rgba(229,57,75,.18)}
.site-header nav{gap:clamp(14px,2vw,28px)}
.nav-cta,.button{box-shadow:0 8px 20px rgba(7,59,117,.12)}
.button.light{color:#fff;box-shadow:0 8px 22px rgba(229,57,75,.22)}
.button.outline{border-color:rgba(255,255,255,.48)}
.hero{background:radial-gradient(ellipse at 78% 12%,rgba(38,112,181,.65) 0%,transparent 44%),linear-gradient(120deg,#062D5B 0%,#073B75 58%,#0A477F 100%)}
.hero:after{border-color:rgba(255,255,255,.16);box-shadow:0 0 0 70px rgba(255,255,255,.025),0 0 0 140px rgba(229,57,75,.035)}
.hero .eyebrow{color:#FF8791}.hero .eyebrow:before{background:#E5394B}
.hero-copy{color:#E0EAF5}.hero-note{color:#D7E5F4}.status-dot{background:#E5394B;box-shadow:0 0 0 5px rgba(229,57,75,.18)}
.art-card{box-shadow:0 30px 80px rgba(0,20,48,.34)}
.art-back{background:linear-gradient(145deg,#fff 0%,#EAF2FA 100%)}
.art-front{background:linear-gradient(145deg,#F24B5C 0%,#D9273C 100%);color:#fff}
.art-sticker{background:#15599B;border-color:rgba(255,255,255,.5);box-shadow:0 15px 35px rgba(0,20,48,.2)}
.trust-strip{box-shadow:0 10px 30px rgba(7,59,117,.025)}
.trust-icon{background:#E7F0FA;color:#073B75}
.portfolio-card{background:#fff;border-color:#E1E8F0;box-shadow:0 5px 18px rgba(7,59,117,.035)}
.portfolio-card:hover{box-shadow:0 22px 48px rgba(7,59,117,.13);border-color:#9AB7D5}
.portfolio-art:before,.portfolio-art:after{border-color:rgba(7,59,117,.12)}
.art-caption{color:#334F6C}
.portfolio-calendar .portfolio-art{background:linear-gradient(145deg,#EAF3FC,#D5E5F5)}
.portfolio-publishing .portfolio-art{background:linear-gradient(145deg,#FBE7E9,#F4D4D9)}
.portfolio-retail .portfolio-art{background:linear-gradient(145deg,#FBE9EB,#F5D4D9)}
.portfolio-packaging .portfolio-art{background:linear-gradient(145deg,#E7F1FB,#CFE1F3)}
.portfolio-info{border-top:1px solid #EEF2F7}
.portfolio-arrow{background:#E8F0F9;color:#073B75}
.portfolio-card:hover .portfolio-arrow{background:#E5394B;color:#fff}
.portfolio-disclaimer{color:#68788B}
.product-card{border-color:#E1E8F0;box-shadow:0 8px 24px rgba(7,59,117,.035)}
.product-card:hover{border-color:#9AB7D5;box-shadow:0 18px 38px rgba(7,59,117,.10)}
.card-number,.portfolio-type{color:#60758B}
.feature-panel{background:linear-gradient(145deg,#EAF3FC,#DCEAF8)}
.feature-panel:after{color:rgba(21,89,155,.09)}
.feature-tag{color:#073B75;border:1px solid #D6E3F1}
.check-list li:before{background:#FCE3E6;color:#B51F31}
.step{border-top-color:#E5394B}.step-num{color:#15599B}
.quote-section{background:linear-gradient(145deg,#EAF2FA,#F5F7FA)}
.contact-note{border:1px solid #E1E8F0;box-shadow:0 8px 22px rgba(7,59,117,.04)}
.quote-form{box-shadow:0 22px 55px rgba(7,59,117,.09);border:1px solid #E3EAF2}
.field input,.field textarea,.field select{border-color:#D8E2ED;background:#FBFDFF}
.field input:focus,.field textarea:focus,.field select:focus{border-color:#15599B;box-shadow:0 0 0 3px rgba(21,89,155,.12)}
.site-footer{background:linear-gradient(120deg,#061F40,#073B75);border-top:4px solid #E5394B}
.footer-link{color:#FF8791}.brand-light .brand-mark{background:#E5394B;color:#fff}
.page-hero{background:radial-gradient(ellipse at 80% 0%,rgba(38,112,181,.55),transparent 48%),linear-gradient(120deg,#062D5B,#073B75);}
.local-badge{background:#E8F1FA;color:#073B75}
.whatsapp-float{right:24px;bottom:24px;background:#20C96B;color:#062D20;border:2px solid #fff;box-shadow:0 14px 36px rgba(3,35,20,.30),0 0 0 5px rgba(32,201,107,.12);padding:16px 23px;min-height:60px;letter-spacing:.005em}
.whatsapp-float:hover{transform:translateY(-4px) scale(1.025);box-shadow:0 18px 42px rgba(3,35,20,.35),0 0 0 7px rgba(32,201,107,.15)}
.whatsapp-float svg{width:25px;height:25px}
@media(prefers-reduced-motion:no-preference){.portfolio-card,.product-card,.button,.nav-cta,.whatsapp-float{transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease,background .22s ease}.product-card:hover{transform:translateY(-4px)}}
@media(max-width:850px){.site-header nav{background:#fff;box-shadow:0 18px 35px rgba(7,59,117,.12)}.hero-grid{gap:28px}.hero-art{margin-top:6px}}
@media(max-width:560px){.whatsapp-float{right:14px;bottom:14px;padding:13px 17px;min-height:55px;font-size:.9rem;box-shadow:0 10px 28px rgba(3,35,20,.3)}.whatsapp-float svg{width:22px;height:22px}.hero h1{font-size:clamp(2.5rem,12vw,3.6rem)}.portfolio-card{border-radius:15px}}

