const { title = 'Your Print Partner | Commercial Printing & Distribution', description = 'High-volume commercial printing and distribution, managed by a dedicated print account contact.', canonical = '/', keywords = 'commercial printing South Africa, bulk printing, print broker, print distribution', lang = 'en-ZA' } = Astro.props;
const site = 'https://yourdomain.com'; // Replace with the purchased domain before launch.
const base = import.meta.env.BASE_URL;
const canonicalPath = canonical.startsWith('/') ? canonical.slice(1) : canonical;
const canonicalUrl = new URL(`${base}${canonicalPath}`, site).toString();
