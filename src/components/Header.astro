---
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <a class="brand" href={base} aria-label="Commercial Print Partner home"><span class="brand-mark">P</span><span>Commercial Print Partner<small>PRINT MANAGEMENT · DISTRIBUTION</small></span></a>
  <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu <span>☰</span></button>
  <nav id="main-nav" aria-label="Main navigation"><a href={base}>Home</a><a href={`${base}#services`}>Services</a><a href={`${base}#portfolio`}>Portfolio</a><a href={`${base}products/calendars/`}>Products</a><a href={`${base}#about`}>Why us</a><a class="nav-cta" href={`${base}#quote`}>Request a quote ↗</a></nav>
</header>
<script is:inline>
  const toggle = document.querySelector('.menu-toggle'); const nav = document.querySelector('#main-nav');
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('is-open', !open); });
</script>
