---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { products } from '../../data.js'; const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Commercial Printing South Africa | Your Print Partner" description="South African commercial printing for corporate diaries, calendars, books, yearbooks, retail tabloids, newspapers, labels, packaging and distribution. Request a tailored quote in South Africa." canonical="/za/" lang="en-ZA" keywords="commercial printing South Africa, bulk printing South Africa, corporate printing, packaging printing, yearbook printing">
<Header/><main><section class="page-hero"><div class="container"><span class="local-badge">South African enquiries · Prices quoted in ZAR</span><span class="eyebrow">Local service, broad capability</span><h1>Commercial printing for South African businesses.</h1><p>Custom print projects, bulk production and distribution coordination—managed through a dedicated point of contact.</p><div class="hero-actions"><a class="button light" href={`${base}#quote`}>Request a quote ↗</a><a class="button outline" href={`${base}#services`}>Explore categories</a></div></div></section><section class="section"><div class="container"><div class="section-head"><span class="eyebrow">Print categories</span><h2>What can we help you produce?</h2><p>Choose a category to see the details worth including in your brief.</p></div><div class="products-grid">{products.map((p,i)=><article class="product-card"><div class="card-number">0{i+1} / CATEGORY</div><h3>{p.name}</h3><p>{p.short}</p><a class="text-link" href={`${base}products/${p.slug}/`}>Explore {p.name.toLowerCase()} <span>→</span></a></article>)}</div></div></section><section class="section quote-section"><div class="container split"><div><span class="eyebrow">South Africa</span><h2>Let’s scope your next print run.</h2><p>Include the quantity, specifications, delivery location and deadline so we can understand the full project.</p><a class="button" href={`${base}#quote`}>Request a tailored quote ↗</a></div><div class="notice">No catalogue prices are shown because print costs depend on volume, size, stock, finishes, schedule and delivery. Share your requirements for a project-specific quote.</div></div></section></main><Footer/>
</BaseLayout>
