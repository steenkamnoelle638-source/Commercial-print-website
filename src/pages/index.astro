---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data.js';
const base = import.meta.env.BASE_URL;

const services = [
  { name: 'Softcover and hardcover books', image: `${base}images/services/books.jpg`, alt: 'Printed books and publications on a table', href: `${base}products/books/` },
  { name: 'Magazines and publications', image: `${base}images/services/magazines.jpg`, alt: 'Printed magazines and publication layouts', href: `${base}products/books/` },
  { name: 'Product catalogues and brochures', image: `${base}images/services/catalogues.jpg`, alt: 'Commercial print media and product catalogue pages', href: `${base}products/retail-tabloids/` },
  { name: 'Retail tabloids and promotional leaflets', image: `${base}images/services/retail.jpg`, alt: 'A collection of retail newspapers and printed tabloids', href: `${base}products/retail-tabloids/` },
  { name: 'Flyers and marketing material', image: `${base}images/services/flyers.webp`, alt: 'Commercial newspaper printing equipment and printed material', href: `${base}products/retail-tabloids/` },
  { name: 'Newspapers and high-volume print projects', image: `${base}images/services/newspapers.jpg`, alt: 'High-volume newspaper printing press', href: `${base}products/newspapers/` },
];
---
<BaseLayout title="Stoney Steenkamp | Novus Print" description="Personal commercial print advice and solutions from Stoney Steenkamp, Group Sales Executive at Novus Print. Books, magazines, catalogues, retail print, flyers and newspapers." canonical="/" keywords="Novus Print, Stoney Steenkamp, commercial printing, books, magazines, catalogues, newspapers, South Africa">
<Header />
<main>
  <section class="hero hero-personal"><div class="container hero-grid"><div class="hero-personal-copy">
    <span class="eyebrow">Novus Print · Personal service · Expert advice</span>
    <h1 class="hero-statement"><span class="hero-line hero-red">ONE TRUSTED CONTACT.</span><span class="hero-line hero-white">EVERY PRINT SOLUTION.</span><span class="hero-line hero-red">PERSONAL SERVICE.<br/>EXPERT ADVICE.<br/>EXCEPTIONAL PRINT.</span></h1>
    <p class="hero-copy">Your print projects deserve personal attention and professional expertise. With more than 30 years of experience in the printing industry, I provide personalised service and expert guidance to help you find the right printing solution for your business.</p>
    <div class="hero-actions"><a class="button light" href="#quote">Get in touch for a quote ↗</a><a class="button outline" href="#services">Explore solutions</a></div>
    <div class="hero-note"><span class="status-dot"></span> Representing Novus Print — from concept to finished product</div>
  </div><div class="hero-art hero-photo-wrap" aria-label="Printed books and publications displayed on shelves"><img class="hero-photo" src={`${base}images/hero/print-shelf.jpg`} alt="A collection of printed books, magazines and publications displayed on shelves"/><span class="hero-photo-label">BOOKS · PUBLICATIONS · PRINT</span></div></div></section>

  <div class="trust-strip"><div class="container trust-inner"><div class="trust-item"><span class="trust-icon">◎</span> One trusted contact</div><div class="trust-item"><span class="trust-icon">▤</span> 30+ years of experience</div><div class="trust-item"><span class="trust-icon">↗</span> Digital, litho, web and flexographic capability</div></div></div>

  <section class="section intro-section"><div class="container split"><div><span class="eyebrow">The right route for your brief</span><h2>Your printing needs, covered.</h2><p>I represent Novus Print and connect you with the right expertise, technology and printing capabilities to bring your projects to life — from concept to finished product.</p><p>From high-quality books and magazines to retail catalogues, promotional flyers and newspapers, we offer a comprehensive range of commercial printing solutions, supported by advanced digital, litho, web and flexographic printing technologies.</p></div><div class="feature-panel feature-panel-personal"><span class="feature-tag">Personal guidance. Practical advice.</span><h3>You bring the project. I bring the experience.</h3><p style="max-width:320px">I help you choose the right printing solution for your requirements, deadlines and budget.</p></div></div></section>

  <section class="section services-section" id="services"><div class="container"><div class="section-head"><span class="eyebrow">Our printing solutions include</span><h2>Print capability matched to your needs.</h2><p>Whether you need a once-off print job or a reliable printing partner for ongoing requirements, I’m here to help you find the right solution.</p></div><div class="service-photo-grid">{services.map((service, i) => <a class="service-photo-card" href={service.href}><div class="service-photo"><img src={service.image} alt={service.alt} loading="lazy"/><span class="service-index">0{i + 1}</span></div><div class="service-photo-copy"><h3>{service.name}</h3><span class="text-link">Discuss this solution <span>↗</span></span></div></a>)}</div><p class="portfolio-disclaimer">All photographs are used for illustrative purposes. Final materials, specifications and production routes depend on your brief.</p></div></section>

  <section class="section products-section" id="products"><div class="container"><div class="section-head"><span class="eyebrow">Products</span><h2>Print solutions in the right order for your brief.</h2><p>Explore the product categories available through one trusted contact at Novus Print.</p></div><div class="products-grid">{products.map((product, i) => <article class="product-card"><div class="card-number">{String(i + 1).padStart(2, '0')} / PRODUCT</div><h3>{product.name}</h3><p>{product.short}</p><a class="text-link" href={`${base}products/${product.slug}/`}>Explore {product.name.toLowerCase()} <span>→</span></a></article>)}</div></div></section>

  <section class="section about-section" id="about"><div class="container split"><div class="feature-panel feature-panel-contact"><span class="feature-tag">Why work with me?</span><h3>One direct conversation can make the whole project clearer.</h3><p style="max-width:310px">Your requirements, deadlines and budget matter. I keep the details connected from the first conversation to the finished print.</p></div><div><span class="eyebrow">Experience you can rely on</span><h2>Why work with me?</h2><ul class="check-list"><li>One trusted contact — personalised service and direct communication throughout your project.</li><li>30+ years of experience — industry knowledge you can rely on.</li><li>Expert guidance — practical advice to help you choose the right printing solution.</li><li>Printing capabilities to match your needs — from smaller digital runs to large-scale commercial production.</li><li>A personal commitment to your project — your requirements, deadlines and budget matter.</li></ul></div></div></section>

  <section class="section quote-section" id="quote"><div class="container quote-grid"><div class="quote-copy"><span class="eyebrow">Let’s bring your next print project to life.</span><h2>Get in touch today for a quote.</h2><p>Tell me what you are planning, and I’ll help you find the right printing solution. You do not need every specification figured out before we start.</p><div class="contact-note contact-details"><strong>Stoney Steenkamp</strong><span>Group Sales Executive · Novus Print</span><a href="tel:+27112013468">t +27 11 201 3468</a><a href="tel:+27827706849">c +27 82 770 6849</a><a href="mailto:Stoney.Steenkamp@novusprint.co.za">Stoney.Steenkamp@novusprint.co.za</a><a href="https://www.novusprint.co.za/" target="_blank" rel="noopener">www.novusprint.co.za ↗</a><a href="https://www.linkedin.com/in/stoney-steenkamp-920a0341/" target="_blank" rel="noopener">Connect on LinkedIn ↗</a></div></div><form class="quote-form" name="print-quote" method="POST" data-netlify="true" netlify-honeypot="bot-field" action={`${base}thank-you/`}><input type="hidden" name="form-name" value="print-quote"/><p hidden><label>Do not fill this out: <input name="bot-field"/></label></p><div class="form-grid"><div class="field"><label for="name">Your name *</label><input id="name" name="name" required autocomplete="name" placeholder="Full name"/></div><div class="field"><label for="company">Company / organisation</label><input id="company" name="company" autocomplete="organization" placeholder="Company name"/></div><div class="field"><label for="email">Work email *</label><input id="email" name="email" type="email" required autocomplete="email" placeholder="you@company.com"/></div><div class="field"><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+27…"/></div><div class="field full"><label for="service">What do you need printed? *</label><select id="service" name="service" required><option value="">Choose a solution</option>{services.map(service => <option value={service.name}>{service.name}</option>)}<option value="Other">Other / not sure yet</option></select></div><div class="field"><label for="quantity">Estimated quantity</label><input id="quantity" name="quantity" type="number" min="1" placeholder="e.g. 5,000"/></div><div class="field"><label for="deadline">Target delivery date</label><input id="deadline" name="deadline" type="date"/></div><div class="field full"><label for="destination">Delivery destination(s)</label><input id="destination" name="destination" placeholder="City, branches, country…"/></div><div class="field full"><label for="specs">Project details / specifications</label><textarea id="specs" name="specs" placeholder="Format, paper, binding, finishing, artwork status, distribution needs…"></textarea></div></div><button class="button" type="submit">Request a tailored quote ↗</button><p class="form-small">Please don’t include confidential information. This form must be connected through Netlify Forms or another form handler before it can receive enquiries.</p></form></div></section>
</main>
<Footer />
</BaseLayout>
