---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data.js';
const groups = [...new Set(products.map(p => p.group))];
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Commercial Printing & Distribution | Your Print Partner" description="High-volume commercial printing, custom corporate products and print distribution. Work directly with a dedicated print account manager for local and international projects." canonical="/" keywords="commercial printing South Africa, bulk printing, corporate diary printing, retail tabloid printing, custom packaging, print distribution, print broker">
<Header />
<main>
<section class="hero"><div class="container hero-grid"><div><span class="eyebrow">Commercial printing · Personal service</span><h1>Commercial print.<br/><em>One trusted</em> contact.</h1><p class="hero-copy">Your dedicated route to high-volume printing, corporate publications, packaging and distribution—without having to coordinate every detail alone.</p><div class="hero-actions"><a class="button light" href="#quote">Discuss your project ↗</a><a class="button outline" href="#services">Explore print services</a></div><div class="hero-note"><span class="status-dot"></span> A personal point of contact from brief to delivery</div></div><div class="hero-art" aria-label="Illustration of printed corporate materials"><div class="art-card art-back"><span class="small-label">YOUR NEXT CAMPAIGN</span><div class="fake-lines" style="width:82%;margin-top:38px"></div><div class="fake-lines" style="width:65%"></div><div class="fake-lines" style="width:74%"></div><div style="margin-top:70px;font:700 1.2rem Manrope">Print with purpose.</div></div><div class="art-card art-front"><div class="small-label">IDEAS INTO PRINT</div><div class="big-p">P.</div><div><div style="font:800 1.45rem Manrope;max-width:190px">Made for your brand.</div><div style="font-size:.76rem;margin-top:10px">Commercial print & distribution</div></div></div><div class="art-sticker">YOUR PROJECT.<br/>OUR FOCUS.<br/><strong>LET’S TALK.</strong></div></div></div></section>
<div class="trust-strip"><div class="container trust-inner"><div class="trust-item"><span class="trust-icon">◎</span> Dedicated account contact</div><div class="trust-item"><span class="trust-icon">▤</span> Custom specifications, not guesswork</div><div class="trust-item"><span class="trust-icon">↗</span> South African and international enquiries</div></div></div>
<section class="portfolio-section" id="portfolio"><div class="container"><div class="portfolio-heading"><div><span class="eyebrow">Print, with purpose</span><h2>From everyday essentials to complex print runs.</h2></div><p>Explore the kinds of print projects we help businesses plan. Every brief is tailored to your format, quantity, finish and distribution requirements.</p></div><div class="portfolio-grid"><a class="portfolio-card portfolio-calendar" href={`${base}products/calendars/`}><div class="portfolio-art"><div class="calendar-sheet"><span class="art-kicker">2027 · BRAND COLLECTION</span><strong>Make<br/>every day<br/><em>count.</em></strong><div class="calendar-grid">{Array.from({length:21},(_,i)=><i class:list={{'highlight-day':i===9||i===16}}></i>)}</div></div><span class="art-caption">CORPORATE CALENDARS</span></div><div class="portfolio-info"><div><span class="portfolio-type">01 / CORPORATE STATIONERY</span><h3>Calendars & diaries</h3></div><span class="portfolio-arrow">↗</span></div></a><a class="portfolio-card portfolio-publishing" href={`${base}products/yearbooks/`}><div class="portfolio-art"><div class="book-stack"><div class="book book-back"><span>YEAR IN REVIEW</span></div><div class="book book-front"><small>2026 · EDITION</small><strong>Stories<br/>worth<br/>keeping.</strong><span>YEARBOOK / PUBLICATION</span></div></div><span class="art-caption">BOOKS · YEARBOOKS</span></div><div class="portfolio-info"><div><span class="portfolio-type">02 / PUBLISHING</span><h3>Books & yearbooks</h3></div><span class="portfolio-arrow">↗</span></div></a><a class="portfolio-card portfolio-retail" href={`${base}products/retail-tabloids/`}><div class="portfolio-art"><div class="retail-sheet"><span class="retail-top">THE WEEKLY EDIT · RETAIL</span><strong>BIG IDEAS.<br/><em>BIG REACH.</em></strong><div class="retail-panels"><i></i><i></i><i></i></div><span class="retail-foot">CAMPAIGNS · CATALOGUES · INSERTS</span></div><span class="art-caption">RETAIL PRINT RUNS</span></div><div class="portfolio-info"><div><span class="portfolio-type">03 / HIGH-VOLUME PRINT</span><h3>Retail print & newspapers</h3></div><span class="portfolio-arrow">↗</span></div></a><a class="portfolio-card portfolio-packaging" href={`${base}products/packaging/`}><div class="portfolio-art"><div class="package-box"><div class="package-top">YOUR BRAND</div><div class="package-side"></div><strong>PACKED<br/>WITH<br/>PURPOSE.</strong><span>PACKAGING CONCEPT</span></div><span class="art-caption">LABELS · PACKAGING</span></div><div class="portfolio-info"><div><span class="portfolio-type">04 / PRODUCT & LOGISTICS</span><h3>Packaging & distribution</h3></div><span class="portfolio-arrow">↗</span></div></a></div><p class="portfolio-disclaimer">These are illustrative design concepts, not photographs of completed client projects. Final materials and finishes depend on your brief.</p></div></section>
<section class="section" id="services"><div class="container"><div class="section-head"><span class="eyebrow">What we print</span><h2>Print solutions built around your brief.</h2><p>From corporate diaries to retail publications and packaging, tell us about your volume, specifications and delivery needs. We’ll help you shape the right print brief.</p></div><form class="search-wrap" role="search" id="site-search"><input id="keyword" type="search" placeholder="Search products or services… e.g. yearbook, labels" aria-label="Search products and services"/><button class="button" type="submit">Search ↗</button></form><p id="search-status" class="search-results" aria-live="polite">Browse all 9 print and distribution categories.</p><div class="products-grid" id="product-grid">{products.map((p,i)=><article class="product-card" data-search={`${p.name} ${p.group} ${p.short} ${p.keywords}`}><div class="card-number">0{i+1} / PRINT CATEGORY</div><h3>{p.name}</h3><p>{p.short}</p><a class="text-link" href={`${base}products/${p.slug}/`}>Explore {p.name.toLowerCase()} <span>→</span></a></article>)}</div><p id="no-results" hidden>No matching services found. Try another keyword or <a href="#quote"><strong>ask us directly</strong></a>.</p></div></section>
<section class="section" id="about" style="background:#fff"><div class="container split"><div class="feature-panel"><span class="feature-tag">A more personal print experience</span><h3>Commercial print coordination. A real person in your corner.</h3><p style="max-width:300px;color:#53655b">A dedicated print account manager helps keep your project clear, coordinated and moving.</p></div><div><span class="eyebrow">Why work with us</span><h2>A more straightforward way to manage print.</h2><p>Print projects often involve many moving parts: quantities, paper, finishes, deadlines, artwork and delivery destinations. Start with one conversation and get the details into a useful brief.</p><ul class="check-list"><li>One direct point of contact for your project</li><li>Product-specific questions to capture the right specifications</li><li>Support for bulk orders and distribution planning</li><li>Quote based on your actual requirements—no made-up one-size-fits-all pricing</li></ul></div></div></section>
<section class="section"><div class="container"><div class="section-head"><span class="eyebrow">How it works</span><h2>From rough idea to a clear print brief.</h2><p>We make it straightforward for procurement teams, businesses and organisations to explain what they need.</p></div><div class="steps"><article class="step"><span class="step-num">STEP 01</span><h3>Tell us the goal</h3><p>Choose a product and share the purpose, approximate quantity and deadline.</p></article><article class="step"><span class="step-num">STEP 02</span><h3>Confirm the details</h3><p>We discuss format, materials, finishes, artwork and delivery requirements.</p></article><article class="step"><span class="step-num">STEP 03</span><h3>Get a tailored quote</h3><p>Your brief gives us the information needed to follow up with a project-specific quote.</p></article></div></div></section>
<section class="section quote-section" id="quote"><div class="container quote-grid"><div class="quote-copy"><span class="eyebrow">Start a conversation</span><h2>Tell us what you’re planning.</h2><p>Share the basics below and we’ll have a starting point for the conversation. You don’t need every specification figured out yet.</p><div class="contact-note"><strong>Prefer a quick chat?</strong><p style="margin:7px 0 0">Use the WhatsApp button on this page to contact the print account manager directly. Replace the placeholder number before launch.</p></div></div><form class="quote-form" name="print-quote" method="POST" data-netlify="true" netlify-honeypot="bot-field" action={`${base}thank-you/`}><input type="hidden" name="form-name" value="print-quote"/><p hidden><label>Do not fill this out: <input name="bot-field"/></label></p><div class="form-grid"><div class="field"><label for="name">Your name *</label><input id="name" name="name" required autocomplete="name" placeholder="Full name"/></div><div class="field"><label for="company">Company / organisation</label><input id="company" name="company" autocomplete="organization" placeholder="Company name"/></div><div class="field"><label for="email">Work email *</label><input id="email" name="email" type="email" required autocomplete="email" placeholder="you@company.com"/></div><div class="field"><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+27…"/></div><div class="field full"><label for="product">What do you need printed? *</label><select id="product" name="product" required><option value="">Choose a category</option>{products.map(p=><option value={p.name}>{p.name}</option>)}<option value="Not sure yet">Not sure yet / multiple products</option></select></div><div class="field"><label for="quantity">Estimated quantity</label><input id="quantity" name="quantity" type="number" min="1" placeholder="e.g. 5,000"/></div><div class="field"><label for="deadline">Target delivery date</label><input id="deadline" name="deadline" type="date"/></div><div class="field full"><label for="destination">Delivery destination(s)</label><input id="destination" name="destination" placeholder="City, branches, country…"/></div><div class="field full"><label for="specs">Project details / specifications</label><textarea id="specs" name="specs" placeholder="Sizes, paper, binding, finishes, artwork status, distribution needs…"></textarea></div></div><button class="button" type="submit">Request a tailored quote ↗</button><p class="form-small">Please don’t include confidential information. This form must be connected through Netlify Forms or another form handler before it can receive enquiries.</p></form></div></section>
</main><Footer/>
<script is:inline>
const form=document.getElementById('site-search');const input=document.getElementById('keyword');const cards=[...document.querySelectorAll('.product-card')];const status=document.getElementById('search-status');const noResults=document.getElementById('no-results');
function runSearch(q){let count=0;const term=q.trim().toLowerCase();cards.forEach(card=>{const match=!term||card.dataset.search.toLowerCase().includes(term);card.hidden=!match;if(match)count++});status.textContent=term?`${count} matching ${count===1?'category':'categories'} for “${q.trim()}”.`:'Browse all 9 print and distribution categories.';noResults.hidden=count!==0;}
form?.addEventListener('submit',e=>{e.preventDefault();runSearch(input.value)});input?.addEventListener('input',()=>runSearch(input.value));
</script>
</BaseLayout>
