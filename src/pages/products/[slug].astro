---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { products } from '../../data.js';
export function getStaticPaths(){ return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const description = `${product.description} Request a tailored quote for your print project.`;
---
<BaseLayout title={`${product.name} Printing | Your Print Partner`} description={description} canonical={`/products/${product.slug}`} keywords={product.keywords}>
<Header/><main><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/#services">Print services</a> / {product.name}</div><span class="eyebrow">{product.group}</span><h1>{product.name} printing, planned around your needs.</h1><p>{product.description}</p><div class="hero-actions"><a class="button light" href="/#quote">Request a tailored quote ↗</a><a class="button outline" href="/#services">Browse all services</a></div></div></section>
<section class="section"><div class="container product-layout"><div><span class="eyebrow">Made to fit the brief</span><h2>Specifications that start the right conversation.</h2><p>{product.short} Every project is different, so we’ll confirm the most suitable options against your quantity, artwork, schedule and delivery destinations.</p><ul class="check-list">{product.options.map(option=><li>{option}</li>)}</ul><p style="margin-top:25px">Have a detailed brief already? Include it in the enquiry form and we can use it as the starting point.</p><a class="button" href="/#quote">Tell us about your project ↗</a></div><aside class="spec-box"><span class="eyebrow">Your project checklist</span><h2>Help us quote accurately.</h2><p>Useful details to prepare before requesting a quote:</p><ul><li>Estimated quantity and repeat-order frequency</li><li>Finished size, page count or dimensions</li><li>Paper, material, binding and finishing preferences</li><li>Artwork status and brand guidelines</li><li>Required delivery date and destination(s)</li><li>Any packing, labelling or distribution requirements</li></ul><a class="text-link" href="/#quote">Complete the quote form <span>→</span></a></aside></div></section>
<section class="section" style="background:#e9ede4"><div class="container split"><div><span class="eyebrow">From print to delivery</span><h2>One brief. Clear next steps.</h2><p>We’ll review your requirements and follow up to clarify any details needed for a tailored quote. For distribution or international delivery, include the destinations and timing in your enquiry.</p><a class="button" href="/#quote">Start an enquiry ↗</a></div><div class="feature-panel"><span class="feature-tag">QUICK TIP</span><h3>The more specific the brief, the more useful the quote.</h3><p style="max-width:310px">If you’re unsure about paper, binding or finishing, describe how the item will be used and we can discuss the options.</p></div></div></section></main><Footer/>
</BaseLayout>
