---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Thank you | Your Print Partner" description="Thank you for your print enquiry." canonical="/thank-you/"><Header/><main><section class="page-hero"><div class="container"><span class="eyebrow">Enquiry submitted</span><h1>Thanks for getting in touch.</h1><p>Your enquiry has been submitted. Once the form handler is connected, the team can review your brief and follow up with you.</p><div class="hero-actions"><a class="button light" href={base}>Back to homepage ↗</a><a class="button outline" href={`${base}#services`}>Explore services</a></div></div></section></main><Footer/></BaseLayout>
